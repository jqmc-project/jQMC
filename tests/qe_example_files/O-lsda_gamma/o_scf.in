&CONTROL
    calculation   = 'scf'
    prefix        = 'o'
    outdir        = './out'
    pseudo_dir    = './'
    verbosity     = 'high'
    tstress       = .false.
    tprnfor       = .false.
    disk_io       = 'medium'
/
&SYSTEM
    ! Single O atom in a 10 Bohr cubic box: minimal LSDA (nspin=2) fixture
    ! for the QE -> jQMC unrestricted conversion path.
    ! O.ccECP: Z_valence = 6 -> triplet ground state: n_up = 4, n_dn = 2.
    ibrav         = 1
    celldm(1)     = 10.0
    nat           = 1
    ntyp          = 1
    ! nbnd > n_occ_up so the fixture also exercises the per-spin band
    ! truncation (n_keep = 4 < nbnd = 6).
    nbnd          = 6
    ecutwfc       = 60.0
    ecutrho       = 240.0
    occupations   = 'fixed'
    nspin         = 2
    tot_magnetization = 2.0
    ! LDA: Slater exchange + Perdew-Zunger 1981 correlation.
    input_dft     = 'pz'
/
&ELECTRONS
    conv_thr      = 1.0d-8
    mixing_beta   = 0.4
    electron_maxstep = 200
/
ATOMIC_SPECIES
    O   15.999  O.ccECP.upf

ATOMIC_POSITIONS {bohr}
    O   5.0  5.0  5.0

K_POINTS {gamma}
