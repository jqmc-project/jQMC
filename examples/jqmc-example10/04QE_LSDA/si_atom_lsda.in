&CONTROL
    calculation   = 'scf'
    prefix        = 'si_atom_lsda'
    outdir        = './out'
    pseudo_dir    = '../../jqmc-example07/01DFT'
    verbosity     = 'high'
    disk_io       = 'medium'
/
&SYSTEM
    ! Isolated Si atom in a periodic box. The ccECP leaves four valence
    ! electrons; tot_magnetization=2 gives N_up=3 and N_down=1.
    ibrav         = 1
    celldm(1)     = 12.0
    nat           = 1
    ntyp          = 1
    nbnd          = 6
    ecutwfc       = 100.0
    ecutrho       = 400.0
    occupations   = 'fixed'
    nspin         = 2
    tot_magnetization = 2.0
    input_dft     = 'pz'
/
&ELECTRONS
    conv_thr         = 1.0d-9
    mixing_beta      = 0.4
    electron_maxstep = 200
/
ATOMIC_SPECIES
    Si  28.085  Si.ccECP.upf

ATOMIC_POSITIONS {bohr}
    Si  6.0  6.0  6.0

K_POINTS {gamma}
